@model EmployeeCrud.Models.Employee

@{
    ViewData["Title"] = "جزئیات پرسنل";
}

<div class="page-header">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <h1 class="page-title">
                جزئیات پرسنل
            </h1>

            <p class="page-description">
                مشاهده اطلاعات کامل پرسنل و فرزندان
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil"></i>
                ویرایش

            </a>

            <a asp-action="Index"
               class="btn btn-light border">

                بازگشت

            </a>

        </div>

    </div>

</div>


<!-- اطلاعات پرسنل -->

<div class="employee-section">

    <div class="section-title">

        <i class="bi bi-person-vcard"></i>

        اطلاعات پرسنل

    </div>


    <div class="row g-4">

        <div class="col-md-3">

            <small class="text-muted">
                کد پرسنلی
            </small>

            <div class="fw-bold mt-1">
                @Model.PersonnelCode
            </div>

        </div>


        <div class="col-md-3">

            <small class="text-muted">
                نام
            </small>

            <div class="fw-bold mt-1">
                @Model.FirstName
            </div>

        </div>


        <div class="col-md-3">

            <small class="text-muted">
                نام خانوادگی
            </small>

            <div class="fw-bold mt-1">
                @Model.LastName
            </div>

        </div>


        <div class="col-md-3">

            <small class="text-muted">
                کد ملی
            </small>

            <div class="fw-bold mt-1">
                @(Model.NationalCode ?? "-")
            </div>

        </div>


        <div class="col-md-3">

            <small class="text-muted">
                تاریخ استخدام
            </small>

            <div class="fw-bold mt-1">

                @(Model.EmploymentDate?
                    .ToString("yyyy/MM/dd") ?? "-")

            </div>

        </div>


        <div class="col-md-3">

            <small class="text-muted">
                سابقه
            </small>

            <div class="fw-bold mt-1">

                @(Model.Experience?.ToString() ?? "-")

            </div>

        </div>


        <div class="col-md-6">

            <small class="text-muted">
                شرکت
            </small>

            <div class="fw-bold mt-1">

                @(Model.CompanyName ?? "-")

            </div>

        </div>


        <div class="col-12">

            <small class="text-muted">
                توضیحات
            </small>

            <div class="mt-1">

                @(Model.Description ?? "-")

            </div>

        </div>

    </div>

</div>


<!-- فرزندان -->

<div class="employee-section">

    <div class="section-title">

        <i class="bi bi-people"></i>

        فرزندان

    </div>


    @if (Model.Children.Any())
    {
        <div class="table-responsive">

            <table class="table">

                <thead>

                    <tr>

                        <th>ردیف</th>
                        <th>نام فرزند</th>
                        <th>تاریخ تولد</th>
                        <th>جنسیت</th>

                    </tr>

                </thead>


                <tbody>

                    @{
                        int row = 1;
                    }

                    @foreach (var child in Model.Children)
                    {
                        <tr>

                            <td>
                                @row
                            </td>

                            <td>
                                @child.Name
                            </td>

                            <td>

                                @(child.BirthDate?
                                    .ToString("yyyy/MM/dd") ?? "-")

                            </td>

                            <td>

                                @(child.Gender switch
                                {
                                    "مرد" => "پسر",
                                    "زن" => "دختر",
                                    _ => "-"
                                })

                            </td>

                        </tr>

                        row++;
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">

            این پرسنل فرزندی ثبت‌شده ندارد.

        </div>
    }

</div>